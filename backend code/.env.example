# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration
# You can provide your MongoDB Atlas URI or local MongoDB URI.
# If left as mongodb://localhost:27017/subscription_management and local MongoDB is not running,
# the backend automatically starts an in-memory MongoDB instance for development & testing!
MONGODB_URI=mongodb://localhost:27017/subscription_management
AUTO_MEMORY_DB=true

# Security & Authentication
JWT_SECRET=production_ready_jwt_super_secret_subscription_flow_key_987654321
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Organization Details (Used in PDF Invoices, Quotes, Receipts & Emails)
COMPANY_NAME=SubFlow Cloud Solutions Ltd.
COMPANY_EMAIL=billing@subflow.io
COMPANY_PHONE=+1 (800) 555-0199
COMPANY_ADDRESS=742 Evergreen Terrace, Suite 500, San Francisco, CA 94107
COMPANY_TAX_ID=US-EIN-987654321
COMPANY_WEBSITE=https://subflow.io

# Client Origins for CORS
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Logging Level: debug, info, warn, error
LOG_LEVEL=info

# Background Scheduled Tasks
ENABLE_CRON_JOBS=true
CRON_INTERVAL_MS=60000

